{
  "name": "campai-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop wrapper for Campai Chat (Naturschule MSE) built with Pake",
  "scripts": {
    "icons": "python3 scripts/generate-icons.py",
    "build:linux": "npx pake-cli --config pake.json --icon icons/icon.png --targets deb,appimage --json",
    "build:macos": "npx pake-cli --config pake.json --icon icons/icon.icns --targets dmg --multi-arch --json",
    "build:windows": "npx pake-cli --config pake.json --icon icons/icon.ico --keep-binary --json"
  },
  "devDependencies": {
    "pake-cli": "^3.19.0"
  }
}
