{
  "name": "naturschule-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop-App für den Naturschule Chat",
  "scripts": {
    "icons": "python3 scripts/generate-icons.py",
    "build:linux": "npx pake-cli --config pake.json --icon icons/icon.png --targets appimage --json",
    "build:macos": "npx pake-cli --config pake.json --icon icons/icon.icns --targets dmg --multi-arch --json",
    "build:windows": "npx pake-cli --config pake.json --icon icons/icon.ico --json"
  },
  "devDependencies": {
    "pake-cli": "^3.19.0"
  }
}
